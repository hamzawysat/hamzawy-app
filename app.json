{
  "expo": {
    "name": "HS",
    "slug": "sonaa",
    "version": "1.0.14",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "platforms": [
      "android"
    ],
    "android": {
      "package": "com.sonaa.app",
      "versionCode": 16,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F4F8FC"
      },
      "minSdkVersion": 23
    },
    "extra": {
      "eas": {
        "projectId": "01cd6ee6-73a2-4404-8381-d60446befcc5"
      }
    },
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#F4F8FC"
    },
    "owner": "sonaa2030",
    "plugins": [
      [
        "expo-notifications",
        {
          "defaultChannel": "hamzawy_official",
          "sounds": [
            "./assets/notification-sounds/HamzawySat_Notification_V12_WOW_Loud.ogg"
          ]
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "السماح لحمزاوي سات بتسجيل وصف الطلب الصوتي."
        }
      ],
      "expo-updates"
    ],
    "updates": {
      "url": "https://u.expo.dev/01cd6ee6-73a2-4404-8381-d60446befcc5",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "requestHeaders": {
        "expo-channel-name": "production"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
